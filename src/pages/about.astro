---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR } from '../consts';

const pillars = [
  {
    title: '🌾 Agriculture & Rural Development',
    desc: 'Exploring Agri-FinTech, credit delivery, farmer producer organizations (FPOs), market linkages, and rural economic transformation driven by digital public goods.',
  },
  {
    title: '🧠 Psychology & Philosophy of Mind',
    desc: 'Investigating cognitive biases, mental models, decision-making under uncertainty, epistemology, and stoic/existential frameworks for navigating modern complexity.',
  },
  {
    title: '🏛️ Politics, Policy & Governance',
    desc: 'Analyzing institutional design, political economy, public policy, regulatory frameworks, and how technology reshapes state capacity and citizen delivery.',
  },
  {
    title: '⚡ Systems Architecture & Scale',
    desc: 'Engineering high-throughput distributed systems, event-driven pipelines, zero-trust infrastructure, and reliable software architectures.',
  },
  {
    title: '👥 Leadership & Team Dynamics',
    desc: 'Building high-trust cultures, psychological safety, autonomous engineering teams, and agile delivery frameworks.',
  },
  {
    title: '🇮🇳 Digital Public Infrastructure (DPI)',
    desc: 'Architecting open, interoperable national-scale digital rails (identity, payments, credit, data empowerment) that empower grassroots communities.',
  },
];

const openSourceProjects = [
  {
    name: 'Awesome-Bash-Aliases',
    desc: 'Curated collection of powerful, production-grade bash/zsh aliases to supercharge developer terminal workflows.',
    url: 'https://github.com/ctrlaltvikas/Awesome-Bash-Aliases',
  },
  {
    name: 'Indian-Gov-API-List',
    desc: 'Comprehensive directory and developer reference for Indian Government public APIs and digital infrastructure.',
    url: 'https://github.com/ctrlaltvikas/Indian-Gov-API-List',
  },
  {
    name: 'cover-card',
    desc: 'Minimalist Jekyll card theme for personal identity portfolios on GitHub Pages.',
    url: 'https://github.com/ctrlaltvikas/cover-card',
  },
];
---

<BaseLayout
  title={`About ${AUTHOR.name} (${AUTHOR.handle})`}
  description={`${AUTHOR.name} is a ${AUTHOR.role} writing at the intersection of technology, psychology, philosophy, politics, and rural development.`}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div class="space-y-10">
      <!-- Profile Header -->
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 border-b border-zinc-200 dark:border-zinc-800 pb-8 text-center sm:text-left">
        <img
          src={AUTHOR.avatar}
          alt={AUTHOR.name}
          class="w-28 h-28 sm:w-32 sm:h-32 rounded-2xl ring-4 ring-emerald-500/20 object-cover shadow-lg"
        />
        <div class="space-y-2 flex-1">
          <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/60">
            {AUTHOR.tagline}
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-950 dark:text-white">
            {AUTHOR.name}
          </h1>
          <p class="text-base font-semibold text-emerald-600 dark:text-emerald-400 font-mono">
            {AUTHOR.handle} • {AUTHOR.role}
          </p>
          <p class="text-xs text-zinc-500 dark:text-zinc-400">
            {AUTHOR.location} • <a href={`mailto:${AUTHOR.email}`} class="hover:underline">{AUTHOR.email}</a>
          </p>
        </div>
      </div>

      <!-- Narrative & Philosophy -->
      <div class="prose prose-zinc dark:prose-invert max-w-none text-zinc-700 dark:text-zinc-300 space-y-4">
        <p class="text-lg leading-relaxed">
          I am a <strong>technology leader</strong> and <strong>digital strategist</strong> with a cross-disciplinary background spanning <strong>enterprise software engineering</strong> (Microsoft, PwC), <strong>digital public infrastructure</strong>, and <strong>rural economic policy</strong> (NABARD - Department of Digital Strategy & Innovation).
        </p>

        <p>
          <strong>Thinking Bytes</strong> is an editorial journal that refuses to separate engineering from the human condition. I believe the most profound insights arise not from hyper-specialized silos, but at the intersections where <strong>systems thinking meets cognitive psychology</strong>, where <strong>political philosophy informs institutional design</strong>, and where <strong>cutting-edge technology meets grassroots agricultural reality</strong>.
        </p>

        <blockquote>
          "Empower autonomous teams, build resilient systems, deliver measurable impact."
        </blockquote>

        <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 pt-4">
          What I Write & Think About
        </h3>
      </div>

      <!-- Pillars Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          pillars.map((pillar) => (
            <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200/70 dark:border-zinc-800/70 space-y-2">
              <h4 class="font-bold text-sm text-zinc-900 dark:text-zinc-100">{pillar.title}</h4>
              <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">{pillar.desc}</p>
            </div>
          ))
        }
      </div>

      <!-- Open Source Projects -->
      <div class="space-y-4 pt-4 border-t border-zinc-200 dark:border-zinc-800">
        <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100">
          Featured Open Source Projects
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {
            openSourceProjects.map((proj) => (
              <a
                href={proj.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group p-4 rounded-xl bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200/80 dark:border-zinc-800/80 hover:border-emerald-500/60 transition-all flex flex-col justify-between"
              >
                <div>
                  <h4 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                    {proj.name} ↗
                  </h4>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1 leading-relaxed">
                    {proj.desc}
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Connect & Social Profiles -->
      <div class="p-6 rounded-2xl bg-gradient-to-br from-emerald-500/5 via-teal-500/5 to-cyan-500/5 border border-emerald-500/20 dark:border-emerald-500/10 space-y-4">
        <h3 class="font-bold text-base text-zinc-900 dark:text-zinc-100">
          Connect & Collaborate
        </h3>
        <p class="text-xs text-zinc-600 dark:text-zinc-400">
          Whether discussing Rural Development, Agri-FinTech, Political Economy, Cognitive Psychology, or Large-Scale Systems Architecture—let's connect!
        </p>

        <div class="flex items-center gap-2.5 flex-wrap">
          <a
            href={AUTHOR.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-[#0A66C2] text-white hover:bg-[#095196] transition-colors"
          >
            LinkedIn
          </a>
          <a
            href={AUTHOR.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors"
          >
            GitHub
          </a>
          <a
            href={AUTHOR.twitter}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-zinc-900 text-white dark:bg-zinc-800 dark:text-zinc-200 hover:bg-zinc-700 transition-colors"
          >
            Twitter / X
          </a>
          <a
            href={`mailto:${AUTHOR.email}`}
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-red-600 text-white hover:bg-red-700 transition-colors"
          >
            Email
          </a>
          <a
            href={AUTHOR.website}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-zinc-100 text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200 hover:bg-zinc-200 transition-colors"
          >
            Portfolio
          </a>
          <a
            href={AUTHOR.stackoverflow}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-amber-600 text-white hover:bg-amber-700 transition-colors"
          >
            Stack Overflow
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
