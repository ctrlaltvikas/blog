---
import { AUTHOR } from '../consts';
import { getAllTags, getAllPosts } from '../utils/posts';
import { getRelativeUrl } from '../utils/url';
import { formatDate } from '../utils/formatDate';

const allTags = (await getAllTags()).slice(0, 8);
const latestPosts = (await getAllPosts()).slice(0, 3);
---

<aside class="space-y-8">
  <!-- Author Bio Card (Medium / Dev.to style) -->
  <div class="rounded-2xl p-6 bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80">
    <div class="flex items-center gap-3.5 mb-4">
      <img
        src={AUTHOR.avatar}
        alt={AUTHOR.name}
        class="w-14 h-14 rounded-full ring-2 ring-emerald-500/30 object-cover"
      />
      <div>
        <h4 class="font-bold text-zinc-900 dark:text-zinc-100 text-base">{AUTHOR.name}</h4>
        <span class="text-xs text-zinc-500 dark:text-zinc-400 block">{AUTHOR.handle}</span>
        <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium">{AUTHOR.location}</span>
      </div>
    </div>

    <p class="text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
      {AUTHOR.bio}
    </p>

    <div class="flex items-center gap-2">
      <a
        href={AUTHOR.github}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 text-center py-1.5 px-3 rounded-lg text-xs font-semibold bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors shadow-xs"
      >
        Follow on GitHub
      </a>
      <a
        href={getRelativeUrl('/about')}
        class="py-1.5 px-3 rounded-lg text-xs font-medium text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 hover:border-zinc-300 dark:hover:border-zinc-600 transition-colors"
      >
        Bio
      </a>
    </div>
  </div>

  <!-- Recommended / Latest Stories -->
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
        Latest Insights
      </h4>
      <a href={getRelativeUrl('/archive')} class="text-xs text-emerald-600 dark:text-emerald-400 hover:underline">
        View all
      </a>
    </div>

    <div class="space-y-3">
      {
        latestPosts.map((post) => {
          const postSlug = post.id.replace(/\.(md|mdx)$/, '');
          return (
            <a
              href={getRelativeUrl(`/blog/${postSlug}`)}
              class="block group p-2.5 -mx-2.5 rounded-lg hover:bg-zinc-100/70 dark:hover:bg-zinc-900/60 transition-colors"
            >
              <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium block mb-1">
                {post.data.category}
              </span>
              <h5 class="text-xs font-semibold text-zinc-800 dark:text-zinc-200 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 line-clamp-2 transition-colors">
                {post.data.title}
              </h5>
              <span class="text-[10px] text-zinc-400 dark:text-zinc-500 mt-1 block">
                {formatDate(post.data.pubDate)}
              </span>
            </a>
          );
        })
      }
    </div>
  </div>

  <!-- Trending Tags Cloud (Dev.to style) -->
  <div class="space-y-3">
    <div class="flex items-center justify-between">
      <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
        Popular Topics
      </h4>
      <a href={getRelativeUrl('/tags')} class="text-xs text-emerald-600 dark:text-emerald-400 hover:underline">
        All tags
      </a>
    </div>

    <div class="flex flex-wrap gap-1.5">
      {
        allTags.map(({ tag, count }) => (
          <a
            href={getRelativeUrl(`/tags/${tag}`)}
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 hover:bg-emerald-50 hover:text-emerald-600 dark:hover:bg-emerald-950/40 dark:hover:text-emerald-400 border border-zinc-200/50 dark:border-zinc-700/50 transition-colors"
          >
            <span>#{tag}</span>
            <span class="text-[10px] text-zinc-400 dark:text-zinc-500 font-semibold">{count}</span>
          </a>
        ))
      }
    </div>
  </div>

  <!-- RSS / GitHub Open Source Card -->
  <div class="rounded-2xl p-5 bg-gradient-to-br from-amber-500/10 via-emerald-500/5 to-teal-500/10 border border-amber-500/20 dark:border-amber-500/10">
    <div class="flex items-center gap-2 mb-2 text-amber-600 dark:text-amber-400">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <circle cx="6.18" cy="17.82" r="2.18"></circle>
        <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"></path>
      </svg>
      <span class="text-xs font-bold uppercase tracking-wider">Stay Updated</span>
    </div>
    <p class="text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed mb-3">
      Subscribe to new engineering posts directly in NetNewsWire, Feedly, or your favorite RSS reader.
    </p>
    <a
      href={getRelativeUrl('/rss.xml')}
      target="_blank"
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:underline"
    >
      Copy RSS Feed URL →
    </a>
  </div>
</aside>
