---
interface Props {
  postSlug: string;
  title: string;
}

const { postSlug, title } = Astro.props;
---

<div
  id="reaction-bar"
  class="flex lg:flex-col items-center justify-center gap-2 p-2 rounded-2xl bg-white/90 dark:bg-zinc-900/90 backdrop-blur-md border border-zinc-200/80 dark:border-zinc-800/80 shadow-md"
  data-slug={postSlug}
  data-title={title}
>
  <!-- Heart Reaction -->
  <button
    type="button"
    class="reaction-btn group relative flex flex-col items-center justify-center w-11 h-11 rounded-xl hover:bg-red-50 dark:hover:bg-red-950/40 text-zinc-600 dark:text-zinc-300 hover:text-red-500 dark:hover:text-red-400 transition-all focus:outline-none"
    data-type="heart"
    title="Like this article"
    aria-label="Heart reaction"
  >
    <span class="emoji text-lg group-hover:scale-125 transition-transform">❤️</span>
    <span class="count text-[10px] font-bold text-zinc-500 dark:text-zinc-400 mt-0.5">0</span>
  </button>

  <!-- Rocket Reaction -->
  <button
    type="button"
    class="reaction-btn group relative flex flex-col items-center justify-center w-11 h-11 rounded-xl hover:bg-purple-50 dark:hover:bg-purple-950/40 text-zinc-600 dark:text-zinc-300 hover:text-purple-500 dark:hover:text-purple-400 transition-all focus:outline-none"
    data-type="rocket"
    title="Rocket / Super Awesome"
    aria-label="Rocket reaction"
  >
    <span class="emoji text-lg group-hover:scale-125 transition-transform">🚀</span>
    <span class="count text-[10px] font-bold text-zinc-500 dark:text-zinc-400 mt-0.5">0</span>
  </button>

  <!-- Mindblown / Lightbulb -->
  <button
    type="button"
    class="reaction-btn group relative flex flex-col items-center justify-center w-11 h-11 rounded-xl hover:bg-amber-50 dark:hover:bg-amber-950/40 text-zinc-600 dark:text-zinc-300 hover:text-amber-500 dark:hover:text-amber-400 transition-all focus:outline-none"
    data-type="bulb"
    title="Mindblown / Insightful"
    aria-label="Lightbulb reaction"
  >
    <span class="emoji text-lg group-hover:scale-125 transition-transform">💡</span>
    <span class="count text-[10px] font-bold text-zinc-500 dark:text-zinc-400 mt-0.5">0</span>
  </button>

  <div class="h-px w-6 bg-zinc-200 dark:bg-zinc-800 my-1 hidden lg:block"></div>

  <!-- Bookmark -->
  <button
    type="button"
    id="bookmark-btn"
    class="group relative flex flex-col items-center justify-center w-11 h-11 rounded-xl hover:bg-blue-50 dark:hover:bg-blue-950/40 text-zinc-600 dark:text-zinc-300 hover:text-blue-500 dark:hover:text-blue-400 transition-all focus:outline-none"
    title="Bookmark for later"
    aria-label="Bookmark article"
  >
    <svg id="bookmark-icon" class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
    </svg>
    <span id="bookmark-text" class="text-[9px] font-medium text-zinc-500 dark:text-zinc-400">Save</span>
  </button>

  <!-- Share Button -->
  <button
    type="button"
    id="share-article-btn"
    class="group relative flex flex-col items-center justify-center w-11 h-11 rounded-xl hover:bg-emerald-50 dark:hover:bg-emerald-950/40 text-zinc-600 dark:text-zinc-300 hover:text-emerald-500 dark:hover:text-emerald-400 transition-all focus:outline-none"
    title="Share this article"
    aria-label="Share article"
  >
    <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
    </svg>
    <span class="text-[9px] font-medium text-zinc-500 dark:text-zinc-400">Share</span>
  </button>
</div>

<script>
  function setupReactions() {
    const bar = document.getElementById('reaction-bar');
    if (!bar) return;

    const slug = bar.dataset.slug || 'default';
    const storageKey = `tb_reactions_${slug}`;
    const initialBaseCounts = {
      heart: Math.floor(Math.abs(hashString(slug + 'heart') % 24) + 12),
      rocket: Math.floor(Math.abs(hashString(slug + 'rocket') % 15) + 6),
      bulb: Math.floor(Math.abs(hashString(slug + 'bulb') % 18) + 8),
    };

    // Simple deterministic hash for pleasant baseline seed
    function hashString(str: string) {
      let hash = 0;
      for (let i = 0; i < str.length; i++) {
        hash = (hash << 5) - hash + str.charCodeAt(i);
        hash |= 0;
      }
      return hash;
    }

    const saved = JSON.parse(localStorage.getItem(storageKey) || '{}');
    const userClicks = saved.userClicks || {};

    const buttons = bar.querySelectorAll('.reaction-btn');
    buttons.forEach((btn) => {
      const type = (btn as HTMLElement).dataset.type as 'heart' | 'rocket' | 'bulb';
      const countEl = btn.querySelector('.count');
      const extra = userClicks[type] || 0;
      const total = initialBaseCounts[type] + extra;

      if (countEl) countEl.textContent = String(total);
      if (extra > 0) btn.classList.add('opacity-100', 'font-black');

      btn.addEventListener('click', (e) => {
        userClicks[type] = (userClicks[type] || 0) + 1;
        localStorage.setItem(storageKey, JSON.stringify({ userClicks }));

        if (countEl) countEl.textContent = String(initialBaseCounts[type] + userClicks[type]);

        // Pop animation
        btn.classList.add('reaction-pop');
        setTimeout(() => btn.classList.remove('reaction-pop'), 400);

        // Spawn floating particle
        spawnParticle(e.clientX, e.clientY, type === 'heart' ? '❤️' : type === 'rocket' ? '🚀' : '💡');
      });
    });

    // Particle spawner
    function spawnParticle(x: number, y: number, emoji: string) {
      const p = document.createElement('span');
      p.className = 'floating-particle fixed text-2xl z-50';
      p.textContent = emoji;
      p.style.left = `${x - 12}px`;
      p.style.top = `${y - 20}px`;
      document.body.appendChild(p);
      setTimeout(() => p.remove(), 800);
    }

    // Bookmark functionality
    const bookmarkBtn = document.getElementById('bookmark-btn');
    const bookmarkIcon = document.getElementById('bookmark-icon');
    const bookmarkText = document.getElementById('bookmark-text');
    const bookmarksKey = 'tb_bookmarks';
    const currentBookmarks = JSON.parse(localStorage.getItem(bookmarksKey) || '[]');
    let isBookmarked = currentBookmarks.includes(slug);

    function updateBookmarkUI() {
      if (!bookmarkIcon || !bookmarkText) return;
      if (isBookmarked) {
        bookmarkIcon.setAttribute('fill', 'currentColor');
        bookmarkIcon.classList.add('text-blue-500');
        bookmarkText.textContent = 'Saved';
      } else {
        bookmarkIcon.setAttribute('fill', 'none');
        bookmarkIcon.classList.remove('text-blue-500');
        bookmarkText.textContent = 'Save';
      }
    }

    updateBookmarkUI();

    if (bookmarkBtn) {
      bookmarkBtn.addEventListener('click', () => {
        let bookmarks = JSON.parse(localStorage.getItem(bookmarksKey) || '[]');
        if (bookmarks.includes(slug)) {
          bookmarks = bookmarks.filter((s: string) => s !== slug);
          isBookmarked = false;
        } else {
          bookmarks.push(slug);
          isBookmarked = true;
        }
        localStorage.setItem(bookmarksKey, JSON.stringify(bookmarks));
        updateBookmarkUI();
      });
    }

    // Share functionality
    const shareBtn = document.getElementById('share-article-btn');
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        const title = bar.dataset.title || document.title;
        const url = window.location.href;

        if (navigator.share) {
          try {
            await navigator.share({ title, url });
          } catch {
            // User cancelled or fallback
          }
        } else {
          // Fallback: Copy link to clipboard
          await navigator.clipboard.writeText(url);
          const originalText = shareBtn.querySelector('span:last-child');
          if (originalText) {
            originalText.textContent = 'Copied!';
            setTimeout(() => {
              originalText.textContent = 'Share';
            }, 2000);
          }
        }
      });
    }
  }

  // Initialize on load
  setupReactions();
</script>
