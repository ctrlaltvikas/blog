---
// Medium-style floating action menu on text selection
---

<div
  id="selection-tooltip"
  class="fixed z-50 hidden -translate-x-1/2 -translate-y-full mb-2 bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 rounded-full px-3 py-1.5 shadow-xl border border-zinc-700 dark:border-zinc-300 items-center gap-2 text-xs font-semibold select-none transition-all duration-150"
>
  <button
    id="copy-quote-btn"
    type="button"
    class="flex items-center gap-1.5 hover:text-emerald-400 dark:hover:text-emerald-600 transition-colors focus:outline-none"
    title="Copy as blockquote"
  >
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
    </svg>
    <span id="copy-quote-label">Quote</span>
  </button>

  <span class="opacity-40">|</span>

  <button
    id="tweet-quote-btn"
    type="button"
    class="flex items-center gap-1 hover:text-cyan-400 dark:hover:text-cyan-600 transition-colors focus:outline-none"
    title="Share quote on X / Twitter"
  >
    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
    </svg>
    <span>Post</span>
  </button>
</div>

<script>
  function setupSelectionQuote() {
    const tooltip = document.getElementById('selection-tooltip');
    const copyBtn = document.getElementById('copy-quote-btn');
    const copyLabel = document.getElementById('copy-quote-label');
    const tweetBtn = document.getElementById('tweet-quote-btn');
    const article = document.querySelector('article.prose');

    if (!tooltip || !article) return;

    let selectedText = '';

    document.addEventListener('selectionchange', () => {
      const selection = window.getSelection();
      if (!selection || selection.isCollapsed) {
        tooltip.classList.add('hidden');
        tooltip.classList.remove('flex');
        return;
      }

      selectedText = selection.toString().trim();
      if (selectedText.length < 5) {
        tooltip.classList.add('hidden');
        tooltip.classList.remove('flex');
        return;
      }

      // Check if selection is inside article prose
      const range = selection.getRangeAt(0);
      if (!article.contains(range.commonAncestorContainer)) {
        tooltip.classList.add('hidden');
        tooltip.classList.remove('flex');
        return;
      }

      const rect = range.getBoundingClientRect();
      tooltip.style.left = `${rect.left + rect.width / 2}px`;
      tooltip.style.top = `${rect.top - 8}px`;
      tooltip.classList.remove('hidden');
      tooltip.classList.add('flex');
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        if (!selectedText) return;
        const formatted = `> "${selectedText}"\n\n— via Thinking Bytes (${window.location.href})`;
        await navigator.clipboard.writeText(formatted);
        if (copyLabel) {
          copyLabel.textContent = 'Copied!';
          setTimeout(() => {
            copyLabel.textContent = 'Quote';
          }, 2000);
        }
      });
    }

    if (tweetBtn) {
      tweetBtn.addEventListener('click', () => {
        if (!selectedText) return;
        const truncated = selectedText.length > 200 ? `${selectedText.slice(0, 197)}...` : selectedText;
        const text = `"${truncated}"\n\nvia ${window.location.href}`;
        const tweetUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}`;
        window.open(tweetUrl, '_blank', 'noopener,noreferrer');
      });
    }
  }

  setupSelectionQuote();
</script>
